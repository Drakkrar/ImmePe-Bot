# Browser profile directory holding the authenticated WhatsApp Web session.
IMMEPE_PROFILE_DIR=.whatsapp-profile
# Keep false for the first login: the QR code must be scanned in a visible window.
IMMEPE_HEADLESS=false
IMMEPE_TIMEOUT_MS=60000
IMMEPE_LOG_LEVEL=INFO
# The exact label on your "Message yourself" chat — your own WhatsApp display name,
# shown at the top of your chat list. Required for `send` and `schedule`.
IMMEPE_SELF_CHAT_TITLE=Your WhatsApp Name

# --- `serve` dashboard + scheduler daemon ---
# SQLite file that stores the scheduled jobs managed by the web dashboard.
IMMEPE_DB_PATH=jobs.db
# Address/port the dashboard binds to. Keep 127.0.0.1 locally; the Docker image sets
# IMMEPE_WEB_HOST=0.0.0.0 so the dashboard is reachable from the host.
IMMEPE_WEB_HOST=127.0.0.1
IMMEPE_WEB_PORT=8000
# Short timeout (ms) for the authenticated-vs-QR session probe used by `status`/`serve`.
IMMEPE_PROBE_TIMEOUT_MS=15000
# Grace period (seconds) for a scheduled fire the service missed while busy or briefly down.
IMMEPE_MISFIRE_GRACE_S=300
