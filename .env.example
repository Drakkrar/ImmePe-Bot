# Browser profile directory holding the authenticated WhatsApp Web session.
IMMEPE_PROFILE_DIR=.whatsapp-profile
# Keep false for the first login: the QR code must be scanned in a visible window.
IMMEPE_HEADLESS=false
IMMEPE_TIMEOUT_MS=60000
IMMEPE_LOG_LEVEL=INFO
# Suffix on your own name in the "Message yourself" chat; depends on the browser
# host's language. "(You)" for English, "(Tú)" for Spanish, etc.
IMMEPE_SELF_CHAT_SUFFIX=(You)
